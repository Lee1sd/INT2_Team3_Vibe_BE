# IDE 로컬 설정
.idea/
*.iml
out/

# Gradle 로컬 빌드 산출물과 캐시
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# 운영체제와 로컬 환경 파일
.DS_Store
Thumbs.db
.env
.env.*
!.env.example

# 로컬 DB 비밀번호 등 실제 값이 담기는 파일 — .example 파일을 복사해서 사용
src/main/resources/application-local.yml

# 애플리케이션 로그
*.log

# .claude/hooks/*.py 실행 시 생기는 파이썬 바이트코드 캐시
__pycache__/
*.pyc

# Claude Code 개인 permission 캐시 (팀 공용 .claude/settings.json은 커밋됨)
.claude/settings.local.json

# new-issue / new-pr 스킬이 gh issue|pr create 전에 잠깐 쓰는 임시 본문 파일
.tmp-issue-body.md
.tmp-pr-body.md

# retro-reminder.py가 세션마다 자동으로 쌓는 개인 로컬 Retro 원본 (팀원 4명이
# 동시에 커밋하면 매 PR마다 충돌하므로 커밋 대상에서 제외 — docs/ai/SHARED.md §5)
docs/ai/workflows/generated/retro-raw.md

# claude 외 에이전트를 위한 셀프 코드리뷰 가이드 (김한비 개인 로컬)
AGENTS.md

