# 로컬 MySQL 접속 정보의 예시이며, 이 파일을 .env로 복사한 뒤 실제 값으로 변경한다.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=career_dungeon
DB_USERNAME=root
DB_PASSWORD=change-me
DB_POOL_SIZE=10
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true

# Google OAuth2 연동 시 사용할 인증 정보이다.
GOOGLE_CLIENT_ID=change-me
GOOGLE_CLIENT_SECRET=change-me

# JWT 서명에 사용할 Base64 인코딩 32바이트 이상의 비밀키이다.
JWT_SECRET=replace-with-a-base64-encoded-secret-of-at-least-32-bytes

# AWS S3 연동 정보이며, 배포 환경에서는 IAM Role 사용을 우선한다.
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=change-me
AWS_ACCESS_KEY_ID=change-me
AWS_SECRET_ACCESS_KEY=change-me

# 로컬 시연에서는 local을 사용하면 이력서 업로드에 AWS 자격증명이 필요하지 않다.
RESUME_STORAGE_MODE=local
RESUME_LOCAL_UPLOAD_BASE_URL=http://localhost:8080/api/resumes/local-upload
# 비워두면 OS 임시 디렉터리 아래 career-dungeon/resumes를 사용한다.
RESUME_LOCAL_STORAGE_DIRECTORY=
